/* @import url('https://fonts.googleapis.com/css2?family=Akaya+Kanadaka&display=swap'); */

:root {
  /* ================================
     Typography
  ================================= */

  font-family: Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;
  line-height: 1.5;

  --text-family: Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;

  /* ================================
     Medical Study - Serene Blue
     Color Palette
  ================================= */

  /* Primary */
  --primary-color: #29B6F6;
  --primary-light: #B3E5FC;
  --primary-soft: #E3F6FD;
  --primary-dark: #0288D1;

  /* Secondary */
  --secondary-color: #81D4FA;
  --accent-color: #4FC3F7;

  /* Backgrounds */
  --bg-color: #F4FAFD;
  --surface-color: #FFFFFF;
  --surface-light: #EAF7FC;

  /* Text */
  --text-color: #062D3D;
  --text-secondary: #496875;
  --text-light: #718A95;

  /* Borders */
  --border-color: #D6EEF8;

  /* Shadows */
  --shadow: rgba(6, 45, 61, 0.12);
  --shadow-hover: rgba(6, 45, 61, 0.18);

  /* Status */
  --success-color: #2E7D32;
  --warning-color: #F9A825;
  --danger-color: #D32F2F;

  /* ================================
     Font Sizes
  ================================= */

  --xxl: 2.5rem;
  --xl: 2rem;
  --lg: 1.5rem;
  --md: 1.25rem;
  --sm: 1rem;
  --xs: 0.8rem;

  max-width: 100%;
  overflow-x: hidden;
  overflow-y: hidden;
}


/* ================================
   Global Styles
================================ */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  padding: 0;
  margin: 0;
  padding-top: 5rem;

  min-height: 100vh;

  font-family: var(--text-family);
  color: var(--text-color);

  background-color: var(--bg-color);

  overflow-y: auto;
  overflow-x: hidden;

  position: relative;

  cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 24 24'><text y='20' font-size='16'>❤️</text></svg>") 8 8, auto;
}


/* ================================
   Background
================================ */

body::before {
  content: "";

  position: fixed;
  inset: 0;

  width: 100%;
  height: 100%;

  background: var(--bg-color);

  z-index: -1;
}


/* ================================
   Common Elements
================================ */

a {
  color: var(--primary-dark);
  text-decoration: none;
}

a:hover {
  color: var(--primary-color);
}

button {
  font-family: inherit;
}


/* ================================
   Selection
================================ */

::selection {
  background: var(--primary-light);
  color: var(--text-color);
}


/* ================================
   Scrollbar
================================ */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--surface-light);
}

::-webkit-scrollbar-thumb {
  background: var(--secondary-color);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary-dark);
}


/* ================================
   Responsive Typography
================================ */

@media (max-width: 768px) {
  :root {
    --xxl: 2rem;
    --xl: 1.75rem;
    --lg: 1.35rem;
    --md: 1.15rem;
    --sm: 0.95rem;
    --xs: 0.75rem;
  }

  body {
    padding-top: 4rem;
  }
}